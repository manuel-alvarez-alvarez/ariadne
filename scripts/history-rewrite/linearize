#!/usr/bin/env bash
# Rebuild a branch's history as a linear, conventional-commit one.
#
# Merge commits are dropped and every remaining commit is replayed, in
# --topo-order, onto the previous replacement with `git commit-tree`, reusing
# the ORIGINAL commit's tree. Reusing the tree is what makes the rewrite
# conflict-free and guarantees the resulting tip tree is byte-identical to the
# source ref's: nothing is ever merged or applied. The accepted trade-off is
# that an intermediate commit's diff can transiently include changes that
# landed on a sibling branch; every commit's authorship and timeline stay exact.
#
# The subject of each replacement comes from message-map.tsv when the commit's
# sha is listed there; otherwise the original subject is passed through, but
# only if it already matches the conventional-commit grammar - an unmapped
# nonconforming commit is a hard error naming the sha. The message body and its
# trailers are kept verbatim below the subject.
#
# Author name, email and date are preserved, the committer date is set to the
# original committer date and the committer identity to the original one, so
# the run is deterministic: same ref + same map => same tip sha, on any machine.
#
# Nothing is pushed and no existing ref is moved: the tip sha is printed on
# stdout, and only the branch named with --branch is created or updated.
#
# Usage: scripts/history-rewrite/linearize [<ref>] [options]
#   <ref>              history to rewrite (default: main)
#   --branch NAME      point local branch NAME at the rewritten tip
#   --map FILE         subject map (default: <this dir>/message-map.tsv)
#   --quiet            print the tip sha only
#   --help, -h         show usage
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"

# The one grammar this repository's history has to speak; release-please reads
# nothing else (see .github/RELEASING.md).
CONVENTIONAL='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9,./ -]+\))?!?: .+'

usage() {
    cat <<'EOF'
Rebuild a branch's history as a linear, conventional-commit one (dry run by
default: it prints a sha and moves nothing).

Usage: scripts/history-rewrite/linearize [<ref>] [options]

  <ref>              history to rewrite (default: main)
  --branch NAME      point local branch NAME at the rewritten tip
  --map FILE         subject map (default: alongside this script)
  --quiet            print the tip sha only
  --help, -h         show this help

The rewritten tip is printed on stdout. Verify it with:

  scripts/history-rewrite/verify main <tip>
EOF
}

REF="main"
BRANCH=""
MAP="$HERE/message-map.tsv"
QUIET=0
REF_SEEN=0
while [ $# -gt 0 ]; do
    case "$1" in
        --branch) BRANCH="$2"; shift 2 ;;
        --map) MAP="$2"; shift 2 ;;
        --quiet) QUIET=1; shift ;;
        --help|-h) usage; exit 0 ;;
        -*) echo "unknown option: $1" >&2; echo >&2; usage >&2; exit 2 ;;
        *)
            [ "$REF_SEEN" = 1 ] && { echo "unexpected argument: $1" >&2; exit 2; }
            REF="$1"; REF_SEEN=1; shift ;;
    esac
done

die() { printf 'linearize: %s\n' "$1" >&2; exit 1; }
note() { [ "$QUIET" = 1 ] || printf '%s\n' "$1" >&2; }

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
git rev-parse --verify --quiet "$REF^{commit}" >/dev/null || die "no such ref: $REF"
[ -f "$MAP" ] || die "no message map at $MAP"

TAB=$'\t'

# --- the map ------------------------------------------------------------------
# Read once, up front, so a typo is reported before a single commit is written.
# Blank lines and # comments are ignored; every other line is
# "<full sha><TAB><new subject>" and its subject must itself be conventional.
lineno=0
while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    case "$line" in ''|'#'*) continue ;; esac
    sha="${line%%"$TAB"*}"
    subject="${line#*"$TAB"}"
    case "$line" in
        *"$TAB"*) : ;;
        *) die "$MAP:$lineno: no tab separator" ;;
    esac
    echo "$sha" | grep -qE '^[0-9a-f]{40}$' \
        || die "$MAP:$lineno: not a full sha: $sha"
    echo "$subject" | grep -qE "$CONVENTIONAL" \
        || die "$MAP:$lineno: new subject is not conventional: $subject"
done < "$MAP"

map_subject() {
    # Print the mapped subject for $1, or nothing when the sha is not listed.
    grep -m1 "^$1$TAB" "$MAP" | sed "s/^[^$TAB]*$TAB//" || true
}

# --- the replay ---------------------------------------------------------------
COMMITS="$(git rev-list --reverse --topo-order --no-merges "$REF")"
TOTAL="$(printf '%s\n' "$COMMITS" | grep -c .)"
note "linearizing $TOTAL non-merge commit(s) of $REF"

parent=""
n=0
US=$'\x1f'
while IFS= read -r sha; do
    n=$((n + 1))
    meta="$(git log -1 --format="%an$US%ae$US%aI$US%cn$US%ce$US%cI" "$sha")"
    IFS="$US" read -r an ae ad cn ce cd <<EOF
$meta
EOF
    message="$(git log -1 --format=%B "$sha")"
    old_subject="${message%%$'\n'*}"
    body="${message#"$old_subject"}"

    new_subject="$(map_subject "$sha")"
    if [ -z "$new_subject" ]; then
        echo "$old_subject" | grep -qE "$CONVENTIONAL" || die \
"$sha is not in $MAP and its subject is not conventional:
    $old_subject
  Add a '<sha><TAB><new subject>' line to the map and run again."
        new_subject="$old_subject"
    fi

    if [ -n "$parent" ]; then
        set -- -p "$parent"
    else
        set --
    fi
    parent="$(
        printf '%s%s' "$new_subject" "$body" |
        GIT_AUTHOR_NAME="$an" GIT_AUTHOR_EMAIL="$ae" GIT_AUTHOR_DATE="$ad" \
        GIT_COMMITTER_NAME="$cn" GIT_COMMITTER_EMAIL="$ce" GIT_COMMITTER_DATE="$cd" \
        git commit-tree "$sha^{tree}" "$@"
    )"

    if [ "$QUIET" != 1 ] && [ $((n % 25)) = 0 ]; then
        note "  $n/$TOTAL"
    fi
done <<EOF
$COMMITS
EOF

[ -n "$parent" ] || die "$REF has no non-merge commits"

if [ -n "$BRANCH" ]; then
    git update-ref "refs/heads/$BRANCH" "$parent"
    note "branch $BRANCH -> $parent"
fi

note "rewritten $TOTAL commit(s); tip:"
printf '%s\n' "$parent"
