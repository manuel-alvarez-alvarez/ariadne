{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "✨ Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "🐛 Bug fixes",
      "hidden": false
    },
    {
      "type": "perf",
      "section": "⚡ Performance",
      "hidden": false
    },
    {
      "type": "revert",
      "section": "⏪ Reverts",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Maintenance",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Styles",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Builds",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous integration",
      "hidden": true
    }
  ],
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value.startsWith('ariadne-'))].version"
        },
        {
          "type": "json",
          "path": "ui/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "ui/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "ui/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "toml",
          "path": "ui/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "ui/src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'ariadne-ui')].version"
        },
        {
          "type": "json",
          "path": "ui/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
