{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value.startsWith('ariadne-'))].version"
        },
        {
          "type": "json",
          "path": "ui/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "ui/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "ui/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "toml",
          "path": "ui/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "ui/src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'ariadne-ui')].version"
        },
        {
          "type": "json",
          "path": "ui/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
