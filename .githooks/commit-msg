#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
# Only a merge in progress receives the exception. Titles never do.
if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
    exit 0
fi
"$root/scripts/check-commit-subject.sh" "$(head -n 1 "${1:?name the message file}")"
