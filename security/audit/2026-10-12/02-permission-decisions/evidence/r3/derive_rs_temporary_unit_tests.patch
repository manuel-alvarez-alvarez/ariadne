+    /// The exact benign/hostile family-match pair this report's PERM-002
+    /// authorization reproduction depends on: both commands normalize to
+    /// the same `learned_key` family (`stdbuf`) and both derive to an empty
+    /// tag set, so nothing in `derive()` or `learned_key::normalize()` can
+    /// tell them apart by family or by tag alone.
+    #[test]
+    fn perm_002_the_benign_and_hostile_stdbuf_commands_share_family_and_empty_tags() {
+        use crate::learned_key::{Facts, normalize};
+        let facts = Facts {
+            repository: "/repo/project".into(),
+            worktree: "/repo/project".into(),
+            branch: None,
+            home: "/home/user".into(),
+        };
+        let benign = normalize("Bash", &json!({"command": "stdbuf -oL printf hello"}), &facts);
+        let hostile = normalize("Bash", &json!({"command": "stdbuf -oL gh auth token"}), &facts);
+        eprintln!(
+            "PERM-002 family match: benign family={} key={} | hostile family={} key={}",
+            benign.family, benign.key, hostile.family, hostile.key
+        );
+        assert_eq!(benign.family, "stdbuf");
+        assert_eq!(hostile.family, "stdbuf");
+        assert_ne!(benign.key, hostile.key, "the normalized command text itself still differs");
+        assert!(derive(&bash("stdbuf -oL printf hello"), Some("/repo/project")).risk_tags.is_empty());
+        assert!(derive(&bash("stdbuf -oL gh auth token"), Some("/repo/project")).risk_tags.is_empty());
+    }
