+    /// Scopes the PERM-002 wrapper claim to exactly the command syntax
+    /// tested: a wrapper with no option of its own (`nohup`), a wrapper
+    /// `operations::WRAPPERS` lists but invoked *with* an option
+    /// (`nice -n 5`), and a wrapper the list does not name at all
+    /// (`stdbuf -oL`). Checked against both `credential_access` (which goes
+    /// through `operations::program_words`, the shared, option-aware
+    /// stripper) and `remote` (whose `REMOTE_PROGRAM` regex embeds its own,
+    /// separate, option-*unaware* wrapper alternation).
+    #[test]
+    fn perm_002_the_wrapper_gap_is_scoped_to_tested_syntax() {
+        let plain = derive(&bash("gh auth token"), Some("/repo/project"));
+        let no_option_wrapper = derive(&bash("nohup gh auth token"), Some("/repo/project"));
+        let listed_wrapper_with_option = derive(&bash("nice -n 5 gh auth token"), Some("/repo/project"));
+        let unlisted_wrapper = derive(&bash("stdbuf -oL gh auth token"), Some("/repo/project"));
+        eprintln!(
+            "PERM-002 scoped: plain={:?} | nohup(no option, listed)={:?} | nice -n 5(option, listed)={:?} | stdbuf -oL(unlisted)={:?}",
+            plain.risk_tags, no_option_wrapper.risk_tags, listed_wrapper_with_option.risk_tags, unlisted_wrapper.risk_tags
+        );
+        assert!(plain.risk_tags.contains(&"credential_access"));
+        assert!(plain.risk_tags.contains(&"remote"));
+
+        assert!(
+            no_option_wrapper.risk_tags.contains(&"credential_access"),
+            "a listed wrapper invoked with no option is stripped by operations::program_words"
+        );
+        assert!(
+            no_option_wrapper.risk_tags.contains(&"remote"),
+            "REMOTE_PROGRAM's own embedded wrapper alternation matches a bare, option-free `nohup `"
+        );
+
+        assert!(
+            listed_wrapper_with_option.risk_tags.contains(&"credential_access"),
+            "operations::program_words understands nice's -n value option and strips it"
+        );
+        assert!(
+            !listed_wrapper_with_option.risk_tags.contains(&"remote"),
+            "REMOTE_PROGRAM's inline alternation requires the wrapper word immediately before the              target program; it has no notion of nice's own -n option, so `nice -n 5 gh auth token`              does not match even though `nice` is in its wrapper list"
+        );
+
+        assert!(
+            !unlisted_wrapper.risk_tags.contains(&"credential_access"),
+            "a wrapper operations::WRAPPERS does not name is never stripped at all"
+        );
+        assert!(!unlisted_wrapper.risk_tags.contains(&"remote"));
+    }
